# ---------------------------------------------------------------------------
# Mood Capsule 环境变量模板
# 用法：把本文件复制为 .env（同目录），填入真实值后重启 node server.js
#       .env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库
# 优先级：系统环境变量 > .env 文件（process.loadEnvFile 不覆盖已有变量）
# ---------------------------------------------------------------------------

# Dify 应用 API Key（形如 app-xxxxxxxxxxxxxxxx），必填，用于共情对话 / 开场白 / 会话变量
DIFY_API_KEY=

# DeepSeek API Key（形如 sk-xxxxxxxxxxxxxxxx），必填，用于情绪胶囊外观设计
DEEPSEEK_API_KEY=

# ---- 以下为可选覆盖项，留空则使用代码内默认值 ----
# Dify API 基础地址（默认 https://api.dify.ai/v1）
# DIFY_BASE_URL=https://api.dify.ai/v1

# DeepSeek API 基础地址（默认 https://api.deepseek.com/v1）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# ---- 部署相关（本地开发一般不用填，详见 DEPLOY.md） ----
# 跨域白名单：前后端分开部署时填前端域名（逗号分隔可多个）；本地开发留空等价于 *
# CORS_ORIGIN=https://mood-capsule.netlify.app

# SQLite 数据目录：默认与 server.js 同级；云平台挂载持久化磁盘后指向挂载点
# DATA_DIR=/var/data

# 监听端口 / 地址：托管平台会自动注入 PORT（此时默认监听 0.0.0.0）；本地默认 8000 / 127.0.0.1
# 自建服务器（PM2 / systemd）常写 PORT=8123、HOST=0.0.0.0（对外监听）；若只走 nginx 反代则用 HOST=127.0.0.1
# 注意：系统环境变量优先级高于本文件，两处都写会以系统环境变量为准（启动日志会标出「配置来源」）
# 自建服务器记得把下面两行的 # 去掉，否则会退回默认的 127.0.0.1:8000
# PORT=8123
# HOST=0.0.0.0

# ⚠️ 不要在这里写 NODE_OPTIONS：它永远不会生效（Node 在加载 .env 之前就读取了 NODE_OPTIONS）。
# 需要给 node 传启动参数（例如 Node 22.5–22.12 的 --experimental-sqlite）时：
#   · PM2：用仓库里的 ecosystem.config.js 启动（已锁定解释器，并按版本自动补参数）
#   · 命令行：node --experimental-sqlite server.js
#   · 推荐直接用 Node ≥ 22.13（node:sqlite 默认可用，无需任何参数）
# NODE_OPTIONS=--experimental-sqlite
